{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 200000,
		"includes": [
			"**",
			"!**/src/sanity/types/sanity.types.ts",
			"!**/schema.json",
			"!**/.context"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noUselessFragments": "info"
			},
			"a11y": {
				"noStaticElementInteractions": "info"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"markdown": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false }
	},
	"yaml": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false }
	},
	"tailwind": {
		"attributes": ["class", "className", "classList"],
		"mergeFunctions": ["cn", "clsx", "tw"],
		"stylesheet": "./src/styles/globals.css"
	}
}
