{
	"name": "sanity-starter",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"predev": "bun run typegen",
		"dev": "next dev",
		"prebuild": "bun run typegen",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "bun run sections:gen && next typegen && tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:e2e": "playwright test --pass-with-no-tests",
		"check": "bun run lint && bun run typecheck && bun test",
		"typegen:extract": "sanity schema extract --path=./schema.json --enforce-required-fields --force",
		"typegen:generate": "sanity typegen generate",
		"typegen": "bun run sections:gen && bun run typegen:extract && bun run typegen:generate",
		"sections:gen": "bun scripts/sections-gen.ts",
		"postinstall": "./scripts/postinstall.sh",
		"analyze": "bunx react-doctor@0.9.22 . && bunx fallow@3.41.0 audit"
	},
	"dependencies": {
		"@portabletext/markdown": "^2.9.6",
		"@portabletext/react": "^8.0.1",
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/icons": "^5.4.0",
		"@sanity/image-url": "^2.2.0",
		"@sanity/orderable-document-list": "^2.0.30",
		"@sanity/ui": "^4.4.12",
		"@sanity/webhook": "^4.0.4",
		"clsx": "^2.1.1",
		"lucide-react": "^1.78.0",
		"next": "^16.4.6",
		"next-sanity": "^13.5.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sanity": "^6.24.0",
		"sanity-plugin-media": "^6.6.4",
		"server-only": "^0.0.1",
		"styled-components": "^6.6.0",
		"tailwind-merge": "^3.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "^1.65.1",
		"@sanity/cli": "^8.33.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
