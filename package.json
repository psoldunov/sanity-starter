{
	"name": "sanity-starter",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"predev": "bun run typegen",
		"dev": "next dev",
		"prebuild": "bun run typegen",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"check": "bun run lint && bun run typecheck && bun test",
		"typegen:extract": "sanity schema extract --path=./schema.json --enforce-required-fields --force",
		"typegen:generate": "sanity typegen generate",
		"typegen": "bun run typegen:extract && bun run typegen:generate",
		"postinstall": "./scripts/postinstall.sh",
		"analyze": "bunx react-doctor@0.9.18 . && bunx fallow@3.36.0 audit"
	},
	"dependencies": {
		"@portabletext/markdown": "^2.7.1",
		"@portabletext/react": "^8.0.1",
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/icons": "^5.2.3",
		"@sanity/image-url": "^2.1.1",
		"@sanity/orderable-document-list": "^2.0.28",
		"@sanity/ui": "^4.4.10",
		"clsx": "^2.1.1",
		"lucide-react": "^1.62.0",
		"next": "^16.4.3",
		"next-sanity": "^13.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sanity": "^6.20.0",
		"sanity-plugin-media": "^6.6.0",
		"server-only": "^0.0.1",
		"styled-components": "^6.6.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@sanity/cli": "^8.24.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
