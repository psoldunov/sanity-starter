{
	"name": "sanity-starter",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"predev": "bun run typegen",
		"dev": "next dev",
		"prebuild": "bun run typegen",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"check": "bun run lint && bun run typecheck && bun test",
		"typegen:extract": "sanity schema extract --path=./schema.json --enforce-required-fields --force",
		"typegen:generate": "sanity typegen generate",
		"typegen": "bun run typegen:extract && bun run typegen:generate",
		"postinstall": "./scripts/postinstall.sh",
		"analyze": "npx -y react-doctor@latest . && npx -y fallow@3 dead-code"
	},
	"dependencies": {
		"@portabletext/react": "^6.0.3",
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/icons": "^5.2.1",
		"@sanity/image-url": "^2.1.1",
		"@sanity/orderable-document-list": "^2.0.23",
		"@sanity/ui": "^4.0.7",
		"blurhash-base64": "^0.0.3",
		"clsx": "^2.1.1",
		"lucide-react": "^1.41.0",
		"next": "^16.3.4",
		"next-sanity": "^13.3.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sanity": "^6.12.0",
		"sanity-plugin-media": "^6.1.8",
		"server-only": "^0.0.1",
		"styled-components": "^6.5.3",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@sanity/cli": "^8.9.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.1",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
