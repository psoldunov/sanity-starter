{
	"$schema": "https://unpkg.com/fallow/schema/fallow.schema.json",

	// Entry points are deliberately NOT declared.
	//
	// fallow's built-in `nextjs` and `sanity` plugins already discover them
	// correctly here: every `src/app/**` special file (`page`, `layout`,
	// `route`, `robots`, `sitemap`, `error`, `loading`, `not-found`,
	// `global-error`) plus `next.config.ts`, `sanity.config.ts` and
	// `sanity.cli.ts`. `fallow recommend` suggests `src/index.*` / `src/main.*`,
	// which is wrong for the App Router and would make the whole site look dead.
	// Verify with `fallow list` before adding anything here.

	"ignorePatterns": [
		// Generated by `bun run typegen`, gitignored, rewritten on every build.
		"src/sanity/types/sanity.types.ts",
		"schema.json",
		// Ensemblr workspace artifacts.
		".context/**"
	],

	"ignoreUnresolvedImports": [
		// `src/sanity/types/sanity.types.ts` is emitted by `bun run typegen` and
		// gitignored, so it is simply absent in any checkout that has not run it —
		// including CI on a fork's pull request, where typegen is skipped because
		// the Sanity project id is not available. Every import of it is
		// `import type`, so nothing resolves at runtime either way.
		//
		// Without this, `fallow audit` fails on three unresolved imports in CI
		// while passing locally, where the file happens to exist.
		"@/sanity/types/sanity.types"
	],

	"ignoreDependencies": [
		// Peer of `@sanity/ui` and `sanity`, imported directly only by
		// `SectionPreview.tsx`. Declared so the Studio resolves one copy; a
		// second copy breaks theming.
		"styled-components",
		// Ambient types loaded via `bun-env.d.ts`, never imported by name.
		"@types/bun",
		// Used at `sanity.config.ts:7`. fallow classifies that file as
		// non-production, so the plugin reads as test-only; it is neither.
		"sanity-plugin-media"
	],

	"ignoreExports": [
		{
			// Deliberate public surface for anyone forking the starter. Nothing in
			// the template consumes them, which is the point — see the comment on
			// the re-export block in that file.
			"file": "src/types/index.ts",
			"exports": ["Page", "Post", "Redirect", "Settings"]
		},
		{
			// Starter-provided hooks. Shipped as usable API rather than because
			// the template needs them.
			"file": "src/hooks/index.ts",
			"exports": ["useVerticalScroll", "useViewportSize"]
		},
		{
			// The component's own prop vocabulary. A consumer adding a variant
			// needs these names; the template only ever passes literals.
			"file": "src/components/elements/Button.tsx",
			"exports": ["ButtonVariant", "ButtonSize"]
		}
	],

	"health": {
		// Small modules with many dependents, by design. Left in, `--targets`
		// recommends "split high-impact file (8 LOC)" for the env module, which
		// is high-impact precisely because centralising it was correct.
		"ignore": [
			"src/sanity/env.ts",
			"src/sanity/env.server.ts",
			"src/config/index.ts",
			"src/config/sections.ts",
			"src/config/linkables.ts",
			// A `describe` block is one long arrow function by construction.
			// Measuring the complexity of the tests is not the point.
			"tests/**"
		],

		// The 60-line default is calibrated for imperative code. In this
		// codebase the long units are JSX and schema object literals, where a
		// "line" is markup rather than a decision — average cyclomatic across the
		// repo is ~2 and maintainability is ~92. Raising the ceiling per area
		// keeps the metric meaningful instead of firing on every component.
		//
		// On `maxCrap`, and what it is actually worth here.
		//
		// CRAP is `CC² × (1 − coverage)³ + CC`. fallow reports
		// `coverage_source: "estimated"` and `coverage_tier: "none"` for this
		// repository — it is not given a coverage file, so coverage is 0 and the
		// formula collapses to `CC² + CC`: a pure restatement of cyclomatic
		// complexity carrying no independent signal. `maxCrap: 400` is therefore
		// `CC ≤ 19`, marginally *stricter* than the `maxCyclomatic: 20` left at
		// its default. Nothing is being hidden; the raised number just stops a
		// second view of the same metric double-reporting every branchy function.
		//
		// Feed `fallow health --coverage coverage-final.json` and CRAP becomes a
		// real signal again — at which point these overrides should come out.
		//
		// `src/lib/**` is not listed below, so it keeps every default. That is
		// where the logic `bun test` exercises lives, and it is the one area
		// where a strict ceiling costs nothing.
		//
		// `maxCyclomatic` is left at its default everywhere. `maxCognitive` is
		// raised in exactly one block — the Studio inputs — and that block says
		// why.
		"thresholdOverrides": [
			{
				// React components. Long because JSX is verbose, not branchy —
				// the cyclomatic and cognitive ceilings stay at their defaults.
				"files": ["src/components/**", "src/app/**"],
				"maxUnitSize": 120,
				"maxCrap": 400
			},
			{
				// Sanity Studio custom inputs. These carry a live query
				// subscription, its loading and error states, and the rendered
				// control in one component, which is how the Studio's input API
				// is shaped.
				//
				// This is the ONE place `maxCognitive` moves off its default of
				// 15, and it is load-bearing: `DestinationReferenceInput` scores
				// 17 and `SectionIdInput` 16. Both are a subscription lifecycle
				// plus its UI states, not tangled logic — but this is a real
				// relaxation, not a no-op, so treat 20 as a ceiling to defend
				// rather than a number to keep raising.
				"files": ["src/sanity/components/**"],
				"maxUnitSize": 180,
				"maxCognitive": 20,
				"maxCrap": 400
			},
			{
				// `src/sanity/lib/**` is server-side glue around the Sanity
				// client — `validateRedirectRoute` queries the dataset, so it is
				// no more unit-testable than a component is. Same CRAP reasoning
				// as above; the pure route rules it delegates to live in
				// `src/lib/routes.ts`, which keeps the strict defaults and is
				// covered by `tests/routing/`.
				"files": ["src/sanity/lib/**"],
				"maxCrap": 400
			},
			{
				// Schema definitions are one large declarative object literal
				// each. Splitting them would scatter a single field list.
				"files": ["src/sanity/schema/**"],
				"maxUnitSize": 200,
				"maxCrap": 400
			}
		]
	},

	"audit": {
		// Only findings the changeset introduces fail CI. A fork's first PR
		// should not inherit the whole repository's backlog.
		"gate": "new-only"
	}
}
