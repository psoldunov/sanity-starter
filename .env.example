# Sanity write token — server-side only. Required for schema deploy + write ops.
# Create at: https://www.sanity.io/manage → Project → API → Tokens (Editor or above)
SANITY_API_WRITE_TOKEN=""

# Sanity read token — exposed to client. Required for draft/preview mode.
# Create at: https://www.sanity.io/manage → Project → API → Tokens (Viewer)
NEXT_PUBLIC_SANITY_API_READ_TOKEN=""

# Sanity project ID — from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# Sanity dataset name — typically "production" or "development"
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity API version — pin to a specific date (YYYY-MM-DD). See https://www.sanity.io/docs/api-versioning
NEXT_PUBLIC_SANITY_API_VERSION=""

# Sanity auth token — PRODUCTION / CI ONLY. Used by `sanity schema deploy` and
# `sanity manifest extract` in postinstall when VERCEL_ENV=production so the
# Dashboard, Canvas, and Agent Actions can discover the studio schema.
# Create at: https://www.sanity.io/manage → Project → API → Tokens (Deploy Studio role)
#
# DO NOT set this in .env.local for local development — it overrides your
# personal CLI session and can break `sanity` commands run from your machine.
# Set it only as a Vercel Production environment variable.
SANITY_AUTH_TOKEN=""
