# ─────────────────────────────────────────────────────────────────────────────
# Sanity project — public. These are inlined into the client bundle by Next.
# ─────────────────────────────────────────────────────────────────────────────

# Sanity project ID — from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# Sanity dataset name — typically "production" or "development"
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity API version — pin to a specific date (YYYY-MM-DD).
# Defaults to DEFAULT_API_VERSION in src/sanity/env.ts when unset.
# See https://www.sanity.io/docs/api-versioning
NEXT_PUBLIC_SANITY_API_VERSION=""

# Canonical site URL, used for metadata, sitemap and robots.
# Optional on Vercel, which supplies VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
NEXT_PUBLIC_SITE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — server-side only. NEVER give any of these a NEXT_PUBLIC_ prefix:
# that inlines the value into the JavaScript every visitor downloads.
# ─────────────────────────────────────────────────────────────────────────────

# Sanity read token — required for draft mode and live preview.
# Needs Viewer permissions and nothing more.
# Create at: https://www.sanity.io/manage → Project → API → Tokens (Viewer)
#
# next-sanity forwards this to the browser itself, over its own server-action
# plumbing, and only on the draft-capable path — so the variable stays server-side.
SANITY_API_READ_TOKEN=""

# Sanity auth token — PRODUCTION / CI ONLY. Used by `sanity schema deploy` and
# `sanity manifest extract` in postinstall when VERCEL_ENV=production so the
# Dashboard, Canvas, and Agent Actions can discover the studio schema.
# Create at: https://www.sanity.io/manage → Project → API → Tokens (Deploy Studio role)
#
# DO NOT set this in .env.local for local development — it overrides your
# personal CLI session and can break `sanity` commands run from your machine.
# Set it only as a Vercel Production environment variable.
SANITY_AUTH_TOKEN=""
